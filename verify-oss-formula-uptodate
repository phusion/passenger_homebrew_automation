#!/bin/bash
set -eo pipefail

SELFDIR=$(dirname "$0")
SELFDIR=$(cd "$SELFDIR" && pwd)
# shellcheck source=lib/functions.sh
source "$SELFDIR/lib/functions.sh"

CORE_GIT_REPO_CACHE=
CORE_GIT_REMOTE=origin

function usage()
{
	echo "Usage: ./verify-oss-formula-uptodate OPTIONS..."
	echo "Verify whether the open source formula is still up-to-date compared to the one in Homebrew-core."
	echo
	echo "Optional options:"
	echo "  -c PATH    Path to local Homebrew-core git repo cache"
	echo "  -r NAME    Remote name in git repo cache. Default: origin"
	echo "  -h         Show usage"
}

function parse_options()
{
	local OPTIND=1
	local opt
	while getopts "c:r:h" opt; do
		case "$opt" in
		c)
			CORE_GIT_REPO_CACHE="$OPTARG"
			;;
		r)
			CORE_GIT_REMOTE="$OPTARG"
			;;
		h)
			usage
			exit
			;;
		*)
			return 1
			;;
		esac
	done

	(( OPTIND -= 1 )) || true
	shift $OPTIND || true
}

# Prints a formula with the parts that are expected to differ between our copy and
# homebrew-core removed: the release tarball URL and checksum, the revision, and the
# bottle block. Homebrew's bots update those for every release and dependency bump,
# so whatever remains is the formula logic that must be kept in sync.
function normalize_formula()
{
	sed -E \
		-e '/^  bottle do$/,/^  end$/d' \
		-e '/^  (url|sha256|revision) /d' |
		cat -s
}

parse_options "$@"

if [[ "$CORE_GIT_REPO_CACHE" = "" ]]; then
	TEMP_DIR=$(mktemp -d /tmp/verify-oss-formula-uptodate.XXXXXX)

	function _cleanup()
	{
		run rm -rf "$TEMP_DIR"
	}

	echo "*** HINT: cloning homebrew-core takes a while. To speed up this operation next time, use specify a cache using -c and -r."
	echo "+ Created temp dir $TEMP_DIR"
	run git clone --bare https://github.com/Homebrew/homebrew-core.git "$TEMP_DIR/repo"
	echo "+ Changing directory to: $TEMP_DIR/repo"
	cd "$TEMP_DIR/repo"
	CORE_REF=main
	echo "+ git log -n 1 --format=%ad main -- Formula/p/passenger.rb"
	CORE_DATE=$(git log -n 1 --format=%ad main -- Formula/p/passenger.rb)
else
	if ! brew tap | grep -q homebrew/core; then
		run brew tap --force homebrew/core
	fi
	if [[ -e "$CORE_GIT_REPO_CACHE" ]]; then
		echo "+ Changing directory to: $CORE_GIT_REPO_CACHE"
		cd "$CORE_GIT_REPO_CACHE"
		run git fetch "$CORE_GIT_REMOTE"
	else
		run git clone --bare https://github.com/Homebrew/homebrew-core.git "$CORE_GIT_REPO_CACHE"
		echo "+ Changing directory to: $CORE_GIT_REPO_CACHE"
		cd "$CORE_GIT_REPO_CACHE"
		if [[ "$CORE_GIT_REMOTE" != origin ]]; then
			run git remote add "$CORE_GIT_REMOTE" https://github.com/Homebrew/homebrew-core.git
			run git fetch "$CORE_GIT_REMOTE"
		fi
	fi
	CORE_REF="$CORE_GIT_REMOTE/main"
	echo "+ git log -n 1 --format=%ad $CORE_GIT_REMOTE/main -- Formula/p/passenger.rb"
	CORE_DATE=$(git log -n 1 --format="%ad" "$CORE_GIT_REMOTE/main" -- Formula/p/passenger.rb)
fi
CORE_TIMESTAMP=$(ruby -rtime -e 'puts Time.parse(ARGV[0]).to_i' "$CORE_DATE")
echo "Homebrew-core's timestamp: $CORE_DATE => $CORE_TIMESTAMP"
CORE_CONTENT=$(git show "$CORE_REF:Formula/p/passenger.rb" | normalize_formula)

echo
echo "+ Changing directory: $SELFDIR"
cd "$SELFDIR"
echo "+ Running: git log -n 1 --format=%ad -- Formula/passenger.rb"
OUR_DATE=$(git log -n 1 --format=%ad -- Formula/passenger.rb)
OUR_TIMESTAMP=$(ruby -rtime -e 'puts Time.parse(ARGV[0]).to_i' "$OUR_DATE")
echo "Our timestamp: $OUR_DATE => $OUR_TIMESTAMP"
OUR_CONTENT=$(normalize_formula < Formula/passenger.rb)

# Our copy is up-to-date if its formula logic matches homebrew-core's. If it doesn't
# match, our copy may hold changes for unreleased Passenger versions, which is fine
# as long as we changed it more recently than homebrew-core did.
echo
if [[ "$OUR_CONTENT" = "$CORE_CONTENT" ]]; then
	echo "Our formula matches the one in the Homebrew official core tap (ignoring url, sha256, revision and bottle)."
elif [[ "$OUR_TIMESTAMP" -ge "$CORE_TIMESTAMP" ]]; then
	echo "Our formula differs from the one in the Homebrew official core tap, but ours was changed more recently."
else
	echo "ERROR: our formula is outdated. The one in the Homebrew official core tap has newer changes. Please merge them over:"
	diff -u --label ours <(echo "$OUR_CONTENT") --label homebrew-core <(echo "$CORE_CONTENT") || [[ $? -eq 1 ]]
	exit 1
fi
